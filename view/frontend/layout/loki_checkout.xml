<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <head>
        <remove src="MultiSafepay_ConnectFrontend::css/styles.css" />
        <remove src="MultiSafepay_ConnectFrontend::css/select2.min.css" />
    </head>

    <body>
        <referenceBlock name="head.additional">
            <block
                name="loki-checkout-multisafepay.stylesheet.payment-components"
                template="LokiCheckout_MultiSafepay::stylesheet/payment-components.phtml"
            />
        </referenceBlock>

        <referenceContainer name="before.body.end">
            <block
                name="loki-checkout-multisafepay.script.payment-component-loader"
                template="LokiCheckout_MultiSafepay::script/payment-component-loader.phtml"
            />
        </referenceContainer>

        <referenceBlock name="loki.script.component">
            <block
                name="loki.script.component.multisafepay-payment-component"
                template="LokiCheckout_MultiSafepay::script/component/payment-component.phtml"
            />
        </referenceBlock>

        <referenceBlock name="loki-checkout.fast_checkout">
            <block
                name="loki-checkout-pay-nl.fast-checkout.paypal"
                template="LokiCheckout_MultiSafepay::fast_checkout/paypal.phtml"
            >
            </block>
        </referenceBlock>
    </body>
</page>
